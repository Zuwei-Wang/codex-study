{
  "name": "codex-study",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first Codex study plugin with versioned materials and cited learning notes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:public": "node scripts/audit-public.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && node scripts/verify-codex.mjs && npm run audit:public && npm audit --audit-level=high",
    "study": "node dist/packages/cli/src/index.js",
    "demo": "npm run build && node dist/examples/demo-workspace/demo.js",
    "mcp": "node dist/packages/mcp/src/index.js",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "schedule": "node dist/packages/scheduler/src/index.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ical.js": "2.2.1",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@openai/codex": "0.144.4",
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
